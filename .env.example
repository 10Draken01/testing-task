# Puerto del servidor
PORT=3000

# Ruta del archivo SQLite (usar :memory: solo en tests)
DB_PATH=./data.db

# URL externa a la que se notifica cuando una tarea se archiva
NOTIFY_URL=https://tu-endpoint-de-notificaciones.com/notify

# Rate limiting (ventana en ms y máximo de requests por IP en esa ventana)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Paginación por defecto para los endpoints GET con listas
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100