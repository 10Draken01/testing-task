# Puerto del servidor
PORT=3000

# Ruta del archivo SQLite (usar :memory: solo en tests)
DB_PATH=./data.db

# URL externa a la que se notifica cuando una tarea se archiva
NOTIFY_URL=https://tu-endpoint-de-notificaciones.com/notify

# Orígenes permitidos para CORS, separados por coma. Vacío = permite cualquiera.
ALLOWED_ORIGINS=

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
 
# Paginación
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100